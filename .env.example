# ---------------------------------------------------------------
# YuniQo — muhit o‘zgaruvchilari (.env.local faylga nusxalang)
# ---------------------------------------------------------------

# Telegram bot tokeni (@BotFather dan olinadi). Bo‘lmasa — web ilova demo rejimda ishlaydi.
TELEGRAM_BOT_TOKEN=
# Bot username (masalan: YuniQo_bot) — web ilovada "Botni ochish" tugmasi uchun
TELEGRAM_BOT_USERNAME=YuniQo_bot

# Frontendning ommaviy HTTPS manzili (Telegram Mini App shu manzilda ochiladi) — Vercel domeni
# Masalan: https://yuniqo.vercel.app yoki https://yuniqo.uz
WEBAPP_URL=

# FAQAT VERCEL’DA: VPS’dagi API manzili. O‘rnatilsa, frontend /api/* so‘rovlarini shu serverga proksi qiladi
# (ma’lumotlar bazasi, bot va bildirishnomalar VPS’da). Masalan: https://api.yuniqo.uz
# VPS’ning o‘zida bu o‘zgaruvchini O‘RNATMANG.
API_PROXY_URL=

# Bot → web API manzili (bot va web bitta serverda bo‘lsa — localhost)
API_URL=http://localhost:3000

# Bot va API o‘rtasidagi maxfiy kalit (ixtiyoriy; bo‘lmasa bot tokenidan hosil qilinadi)
BOT_API_SECRET=

# Qo‘llab-quvvatlash xabarlari yuboriladigan admin chat ID (ixtiyoriy)
ADMIN_CHAT_ID=

# Ota-onalar hamjamiyati Telegram guruhi havolasi (ixtiyoriy)
COMMUNITY_URL=

# Claude API (AI yordamchi, AI xulosa va AI reja). Bo‘lmasa — oflayn demo AI javoblari ishlaydi.
ANTHROPIC_API_KEY=
# Model (standart: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Ko‘rgazma paneli (/admin) himoyasi — o‘rnatilsa /admin?key=... bilan ochiladi
ADMIN_KEY=
