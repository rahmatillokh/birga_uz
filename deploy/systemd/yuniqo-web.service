# /etc/systemd/system/yuniqo-web.service — YuniQo web ilova + API (Next.js)
[Unit]
Description=YuniQo web (Next.js) — yuniqo.aysapps.uz
After=network.target

[Service]
Type=simple
User=yuniqo
WorkingDirectory=/home/yuniqo/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 8030
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
