# /etc/systemd/system/yuniqo-bot.service — @YuniQo_bot (grammY, long polling)
# .env.local da TELEGRAM_BOT_TOKEN bo'lishi shart (tokensiz bot 0 kod bilan chiqadi).
[Unit]
Description=YuniQo Telegram bot (@YuniQo_bot)
After=network.target yuniqo-web.service
Wants=yuniqo-web.service

[Service]
Type=simple
User=yuniqo
WorkingDirectory=/home/yuniqo/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs bot/index.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
